// Reference markdownlint configuration for Markdown structure.
//
// markdownlint (https://github.com/DavidAnson/markdownlint) enforces the mechanical
// Markdown rules in §6 of references/style-guide.md — the ones that are objectively
// checkable and not worth a human's attention in review. Vale handles prose; this
// handles syntax. `/docs-lint-setup` copies this to `.markdownlint.jsonc`.
//
//   markdownlint-cli2 "**/*.md"     # lint
//   markdownlint-cli2 --fix "**/*.md"
{
  "default": true,

  // Semantic line breaks (one clause per line) make prose diffs readable, so line
  // length is deliberately not enforced. This is the single most common reason a
  // repo abandons markdownlint — it is off on purpose.
  "MD013": false,

  // ATX headings (`##`), never underlines.
  "MD003": { "style": "atx" },

  // Consistent list markers.
  "MD004": { "style": "dash" },
  "MD029": { "style": "ordered" },

  // Duplicate headings are fine across sections, not within one.
  "MD024": { "siblings_only": true },

  // Inline HTML only where Markdown genuinely cannot express the thing.
  "MD033": { "allowed_elements": ["br", "kbd", "sub", "sup", "details", "summary", "img", "a"] },

  // Fenced code blocks, backtick fences, always with a language tag — an untagged
  // fence loses syntax highlighting silently.
  "MD040": true,
  "MD046": { "style": "fenced" },
  "MD048": { "style": "backtick" },

  // Terminology: fix the casing of names that get mistyped. Mirrors the Vale
  // vocabulary — keep the two lists in step.
  "MD044": {
    "names": ["Markdown", "JSON", "YAML", "GitHub", "JavaScript", "TypeScript", "Vale", "markdownlint"],
    "code_blocks": false,
    "html_elements": false
  },

  // One H1, matching the title; first line is that H1.
  "MD025": true,
  "MD041": true,

  // Whitespace hygiene.
  "MD009": true,
  "MD012": true,
  "MD047": true,

  // Bare URLs in body prose lose their descriptive text (style guide §5). Angle-bracket
  // autolinks (<https://…>) are the sanctioned form and satisfy this rule.
  "MD034": true
}
